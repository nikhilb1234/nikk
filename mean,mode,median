import random
import statistics as stats

# Generate random data
random.seed(42)  # For reproducibility
x = [random.randint(1, 100) for _ in range(20)]
y = [random.randint(1, 100) for _ in range(20)]

# Calculate statistics for x
mean_x = stats.mean(x)
median_x = stats.median(x)
mode_x = stats.mode(x)
std_dev_x = stats.stdev(x)

# Calculate statistics for y
mean_y = stats.mean(y)
median_y = stats.median(y)
mode_y = stats.mode(y)
std_dev_y = stats.stdev(y)

# Print results
print("Statistics for X:")
print(f"Data: {x}")
print(f"Mean: {mean_x}")
print(f"Median: {median_x}")
print(f"Mode: {mode_x}")
print(f"Standard Deviation: {std_dev_x}\n")

print("Statistics for Y:")
print(f"Data: {y}")
print(f"Mean: {mean_y}")
print(f"Median: {median_y}")
print(f"Mode: {mode_y}")
print(f"Standard Deviation: {std_dev_y}")
